# PayPal Advanced CardFields client ID (public, safe to expose to browser)
NUXT_PUBLIC_PAYPAL_CLIENT_ID=

# Google Maps JavaScript API browser key for the store-location picker on
# /partner-listing. Public by nature (it ships in the page), so restrict it in
# Google Cloud by HTTP referrer AND to these three APIs: Maps JavaScript API,
# Places API (New), Geocoding API. Leave blank to fall back to a plain
# "paste your Google Maps link" input.
#
# Note: `nuxt dev` loads .env, not .env.local. If the value lives in .env.local,
# run `nuxt dev --dotenv .env.local`. It is read at BUILD time, so changing it
# in Vercel requires a redeploy.
GOOGLE_API_NAVITAG_COM_PUBLIC=
